<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.GhostTrace" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent_cyan</item>
        <item name="colorPrimaryVariant">@color/accent_purple</item>
        <item name="colorOnPrimary">@color/bg_dark</item>
        <item name="colorSecondary">@color/accent_purple</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:colorBackground">@color/bg_dark</item>
        <item name="colorSurface">@color/bg_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:statusBarColor">@color/bg_card</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
    </style>

    <style name="Theme.GhostTrace.Splash" parent="Theme.GhostTrace">
        <item name="android:windowBackground">@color/bg_dark</item>
    </style>

    <style name="GhostChip" parent="Widget.MaterialComponents.Chip.Filter">
        <item name="android:textSize">10sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="chipBackgroundColor">@color/bg_card</item>
        <item name="chipStrokeColor">@color/border_strong</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="chipMinHeight">28dp</item>
        <item name="checkedIconVisible">false</item>
        <!-- checked state tinted with accent -->
    </style>

    <style name="GhostOutlineButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/text_primary</item>
        <item name="strokeColor">@color/border_strong</item>
        <item name="strokeWidth">1dp</item>
        <item name="backgroundTint">@color/bg_card</item>
        <item name="iconTint">@color/muted</item>
        <item name="rippleColor">@color/accent_cyan</item>
        <item name="cornerRadius">4dp</item>
    </style>

</resources>
